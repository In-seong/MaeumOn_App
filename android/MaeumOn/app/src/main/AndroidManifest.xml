<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 웹뷰 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 위치: 사용하지 않으므로 라이브러리가 추가하는 권한도 제거 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />

    <uses-feature android:name="android.hardware.location.gps" tools:node="remove" />
    <uses-feature android:name="android.hardware.location.network" tools:node="remove" />
    <!-- nfc: 사용하지 않으므로 제거 -->
    <uses-permission android:name="android.permission.NFC" tools:node="remove" />
    <uses-feature android:name="android.hardware.nfc" tools:node="remove" />
    <!-- ble: 사용하지 않으므로 제거 -->
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- qr -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.spoon.maeumon.MyApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobiliteasyBase">
        <service
            android:name="com.spoon.maeumon.feature.fcm.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_foreground" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/color_primary" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_channel_id" />

        <activity
            android:name="com.spoon.maeumon.feature.splash.ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.spoon.maeumon.feature.webView.ui.WebViewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
        </activity>
        <activity android:name="com.spoon.maeumon.feature.common.ui.BaseActivity" />
        <activity
            android:name="com.spoon.maeumon.feature.qr.ui.QrActivity"
            android:launchMode="singleTop" />

        <!-- 비콘 라이브러리 컴포넌트 제거 (사용하지 않음) -->
        <service android:name="org.altbeacon.beacon.service.BeaconService" tools:node="remove" />
        <service android:name="org.altbeacon.beacon.BeaconIntentProcessor" tools:node="remove" />
        <service android:name="org.altbeacon.beacon.service.ScanJob" tools:node="remove" />
        <service android:name="org.altbeacon.bluetooth.BluetoothTestJob" tools:node="remove" />
        <receiver android:name="org.altbeacon.beacon.startup.StartupBroadcastReceiver" tools:node="remove" />

        <!-- 카메라 촬영 파일 공유용 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
